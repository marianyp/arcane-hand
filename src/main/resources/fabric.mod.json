{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_page_url}",
    "sources": "${mod_git_url}"
  },
  "license": "${mod_license}",
  "icon": "assets/arcanehand/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.mariany.arcanehand.ArcaneHand"
    ],
    "client": [
      "dev.mariany.arcanehand.client.ArcaneHandClient"
    ],
    "fabric-datagen": [
      "dev.mariany.arcanehand.ArcaneHandDataGenerator"
    ]
  },
  "mixins": [
    "arcanehand.mixins.json"
  ],
  "accessWidener": "arcanehand.accesswidener",
  "depends": {
    "fabricloader": ">=0.18.1",
    "minecraft": ">=1.21.9",
    "java": ">=21",
    "fabric-api": ">=0.138.3"
  }
}